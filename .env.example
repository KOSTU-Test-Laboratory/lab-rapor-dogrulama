# Kopyalayın: cp .env.example .env ; chmod 600 .env
# Önce CHANGE_ME / GENERATE_* değerlerini gerçek değerlerle değiştirin.
# Üç anahtar için ayrı ayrı `openssl rand -hex 32` çalıştırın.
# JWT_SECRET ve QR_SECRET farklı olmalı. QR_SECRET ve QR_ID_SECRET'ı güvenle yedekleyin.
# Bu dosyayı veya .env dosyasını paylaşmayın.

ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=GENERATE_RANDOM_KEY
QR_SECRET=GENERATE_DIFFERENT_RANDOM_KEY
QR_ID_SECRET=GENERATE_QR_ID_KEY

# Yerel geliştirme: localhost:3000 doğrulama, localhost:3001 QR üretici.
BASE_URL=http://localhost:3000
COOKIE_SECURE=0
TRUST_PROXY=0

# Üretimde HTTPS alan adınızla değiştirin ve bu satırları etkinleştirin:
# BASE_URL=https://DOMAIN
# COOKIE_SECURE=1
# TRUST_PROXY=1
# DOMAIN=DOMAIN
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
