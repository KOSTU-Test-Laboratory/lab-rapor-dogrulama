# Bu dosyayı .env olarak kopyalayın: cp .env.example .env ; chmod 600 .env
# Değerleri satırın sonuna yorum eklemeden, tırnak ve boşluk kullanmadan yazın.
# .env dosyasını asla paylaşmayın ve git'e eklemeyin. QR_SECRET'ı yedekleyin.

# Admin parolası: en az 12 karakter; harf, rakam, - ve _ kullanın.
# #, $, tırnak ve boşluk kullanmayın. "password", "changeme", "degistir" içermesin.
ADMIN_PASSWORD=abcABC123*!?

# Oturum imzası: en az 32 karakter. Üretmek için: openssl rand -hex 32
JWT_SECRET=UHdpBESUVan0Tc5izOggoLKxQIQNAczq

# Seri no / QR / dosya / imza anahtarlarının kaynağı: en az 32 karakter, JWT_SECRET'tan FARKLI olmalı.
# Üretmek için: openssl rand -hex 32
# ASLA değiştirmeyin veya kaybetmeyin; değişirse tüm QR'lar, imzalar ve PDF'ler çözülemez.
QR_SECRET=UHdpBESUVan0Tc5izOggoLKxQIQNAczq

# --- Sunucu (HTTPS) kurulumu: KURULUM.md §5 ---
# QR'a gömülen adres. ALAN_ADI yerine kendi alan adınızı yazın (https:// kalsın).
BASE_URL=https://ALAN_ADI
COOKIE_SECURE=1
TRUST_PROXY=1
BIND=127.0.0.1
DOMAIN=ALAN_ADI
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Yerel test için (yukarıdaki sunucu bölümü yerine) ---
# BASE_URL=http://localhost:3000
# COOKIE_SECURE=0
# TRUST_PROXY=0
# BIND=127.0.0.1
# DOMAIN ve COMPOSE_FILE satırlarını silin.
